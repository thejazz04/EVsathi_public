# EVsathi Backend Configuration Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Replica Set recommended for transaction support)
MONGODB_URI=mongodb://localhost:27017/evsathi?replicaSet=rs0

# JWT Secrets & Expiration
JWT_SECRET=evsathi_production_jwt_secret_key_2026_super_secure
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=evsathi_production_jwt_refresh_secret_key_2026
JWT_REFRESH_EXPIRES_IN=30d

# Payment Configuration (PAYMENT_MODE=razorpay or PAYMENT_MODE=mock)
# Note: PAYMENT_MODE=mock is strictly forbidden when NODE_ENV=production
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=rzp_test_EVsathiKeyId123
RAZORPAY_KEY_SECRET=EVsathiRazorpaySecret456
RAZORPAY_WEBHOOK_SECRET=EVsathiRazorpayWebhookSecret789

# Telemetry & Charging Simulation (CHARGING_MODE=simulation or CHARGING_MODE=ocpp)
CHARGING_MODE=simulation

# Navigation & Routing Provider (NAVIGATION_PROVIDER=osrm)
NAVIGATION_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org/route/v1/driving

# Storage Service Abstraction (STORAGE_PROVIDER=local or STORAGE_PROVIDER=s3)
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads

# Firebase Push Notifications (Optional in dev)
FIREBASE_ENABLED=false
FIREBASE_SERVICE_ACCOUNT_PATH=config/firebase-service-account.json

# ML Microservice Endpoint (Interfaces only in Node.js)
ML_ENABLED=false
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_API_KEY=evsathi_ml_secret_key
ML_SERVICE_TIMEOUT=3000

# CORS Allowed Origins
CLIENT_ORIGIN=http://localhost:5173
