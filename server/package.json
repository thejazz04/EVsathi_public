{
  "name": "evsathi-backend",
  "version": "1.0.0",
  "description": "Production Node.js, Express, MongoDB, Socket.IO, Razorpay, & Firebase backend for EVsathi P2P EV Charger-Sharing Marketplace",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seeds/seed.js",
    "seed:mysore": "node seeds/seedMysore.js",
    "seed:fix-coords": "node seeds/fixCoordinates.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit"
  },
  "keywords": [
    "evsathi",
    "ev-charging",
    "p2p-marketplace",
    "express",
    "mongodb",
    "socket.io",
    "razorpay"
  ],
  "author": "EVsathi Engineering",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.3.1",
    "firebase-admin": "^12.1.0",
    "helmet": "^7.1.0",
    "joi": "^17.13.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "multer": "^1.4.5-lts.1",
    "razorpay": "^2.9.4",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.2.0",
    "nodemon": "^3.1.2",
    "supertest": "^7.0.0"
  }
}
